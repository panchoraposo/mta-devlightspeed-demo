VM_USER=ec2-user
VM_SSH_KEY=~/.ssh/id_rsa

# VM running JBoss EAP 7 (legacy, non-container)
VM_EAP7_HOST=eap7-legacy.example.com
VM_EAP7_HTTP_PORT=8080
VM_EAP7_MGMT_PORT=9990

# Local path to EAP 7 ZIP (downloaded from Red Hat Customer Portal)
# Example: ~/Downloads/jboss-eap-7.4.0.zip
EAP7_ZIP_PATH=

# PostgreSQL (on the same EAP7 VM)
PG_DB=payments
PG_USER=payments
PG_PASSWORD=payments

# VM running Spring Boot 2 legacy JAR
VM_INVENTORY_HOST=inventory-legacy.example.com
VM_INVENTORY_PORT=8082

# ---------------------------------------------------------------------------
# Open Liberty "WAS9" track (Java EE 7 + ibm-web-* descriptors)
# Can reuse the EAP7 VM host or point at a dedicated RHEL box.
# ---------------------------------------------------------------------------
VM_WAS9_HOST=was9-liberty.example.com
VM_WAS9_HTTP_PORT=9080

# Local path to Open Liberty runtime ZIP (or leave empty to download in provision)
# Example: ~/Downloads/openliberty-23.0.0.12.zip
OPENLIBERTY_ZIP_PATH=

# Optional override of download URL used when OPENLIBERTY_ZIP_PATH is empty
# OPENLIBERTY_DOWNLOAD_URL=https://repo1.maven.org/maven2/io/openliberty/openliberty-runtime/23.0.0.12/openliberty-runtime-23.0.0.12.zip

# Postgres DBs for Liberty apps (created by provision-postgres-was9.sh)
PG_ACCOUNTS_DB=accounts
PG_ACCOUNTS_USER=accounts
PG_ACCOUNTS_PASSWORD=accounts
PG_CARDS_DB=cards
PG_CARDS_USER=cards
PG_CARDS_PASSWORD=cards
